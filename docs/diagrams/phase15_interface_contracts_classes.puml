@startuml phase15_interface_contracts_classes
!theme plain
skinparam classAttributeIconSize 0
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 12

title Phase 15.0: Provider-Agnostic Interfaces

package "semantic_core.interfaces" {
    abstract class BaseEmbedder {
        {abstract} +embed_documents(texts: list[str]): list[ndarray]
        {abstract} +embed_query(text: str): ndarray
        {abstract} +dimension: int <<property>>
        {abstract} +max_tokens: int <<property>>
    }
    
    abstract class ITranscriber {
        {abstract} +transcribe(audio_path: Path, language: str|None): TranscriptionResult
        {abstract} +supported_formats: list[str] <<property>>
    }
    
    abstract class IVisionAnalyzer {
        {abstract} +analyze(image_path: Path, prompt: str|None): VisionResult
        {abstract} +supported_formats: list[str] <<property>>
    }
}

package "semantic_core.domain" {
    class TranscriptionSegment {
        +text: str
        +start_time: float
        +end_time: float
    }
    
    class TranscriptionResult {
        +full_text: str
        +segments: list[TranscriptionSegment]
        +language: str|None
    }
    
    class VisionResult {
        +description: str
        +objects: list[str]|None
        +text: str|None
        +tags: list[str]|None
    }
}

package "semantic_core.infrastructure.gemini" {
    class GeminiEmbedder {
        -_dimension: int = 768
        -_max_tokens: int = 2048
        +model_name: str
        +embed_documents(texts): list[ndarray]
        +embed_query(text): ndarray
        +dimension: int
        +max_tokens: int
    }
    
    class GeminiAudioAnalyzer {
        +transcribe(audio_path, language): TranscriptionResult
        +supported_formats: list[str]
    }
    
    class GeminiImageAnalyzer {
        +analyze(image_path, prompt): VisionResult
        +supported_formats: list[str]
    }
}

package "semantic_core" {
    class SemanticCore {
        +embedder: BaseEmbedder
        +vision_analyzer: IVisionAnalyzer|None
        +transcriber: ITranscriber|None
        --deprecated--
        +image_analyzer: GeminiImageAnalyzer|None
        +audio_analyzer: GeminiAudioAnalyzer|None
    }
}

' Наследование
BaseEmbedder <|-- GeminiEmbedder
ITranscriber <|.. GeminiAudioAnalyzer
IVisionAnalyzer <|.. GeminiImageAnalyzer

' Композиция
SemanticCore o-- BaseEmbedder
SemanticCore o-- ITranscriber
SemanticCore o-- IVisionAnalyzer

' Использование DTOs
ITranscriber ..> TranscriptionResult : <<returns>>
TranscriptionResult *-- TranscriptionSegment
IVisionAnalyzer ..> VisionResult : <<returns>>

note right of BaseEmbedder
  **Phase 15.0 Extension:**
  Added dimension & max_tokens
  properties for model metadata
end note

note bottom of ITranscriber
  **New Interface (Phase 15.0)**
  Unified contract for:
  - Gemini Audio API
  - Whisper (Phase 15.1)
  - AssemblyAI (future)
end note

note bottom of IVisionAnalyzer
  **New Interface (Phase 15.0)**
  Unified contract for:
  - Gemini Vision
  - LLaVA (future)
  - Azure Vision (future)
end note

note top of SemanticCore
  **Backward Compatibility:**
  Old parameters (image_analyzer,
  audio_analyzer) still work but
  are deprecated in favor of
  new interface-based parameters
end note

@enduml
