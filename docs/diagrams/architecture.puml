@startuml architecture
title Semantic Core Architecture

package "Domain" {
    [Document]
    [Chunk]
    [SearchResult]
}

package "Interfaces" {
    interface "BaseEmbedder" as emb
    interface "BaseVectorStore" as vs
    interface "BaseSplitter" as sp
    interface "BaseLLMProvider" as llm
    interface "DocumentParser" as dp
}

package "Infrastructure" {
    package "Gemini" {
        [GeminiEmbedder] as ge
        [GeminiLLMProvider] as glp
        [ImageAnalyzer] as ia
        [AudioAnalyzer] as aa
    }
    package "Local" {
        [LocalEmbedder] as le
        [WhisperTranscriber] as wt
    }
    package "Storage" {
        [PeeweeVectorStore] as pvs
    }
    package "Processing" {
        [SmartSplitter] as ss
        [MarkdownNodeParser] as mnp
    }
}

package "Core" {
    [SemanticCore] as sc
    [RAGEngine] as rag
    [MediaQueueProcessor] as mqp
    [BatchManager] as bm
    [ComponentFactory] as factory
}

package "CLI" {
    [ingest]
    [search]
    [chat]
}

[ingest] --> sc
[search] --> sc
[chat] --> rag

sc --> emb
sc --> vs
sc --> sp
sc --> llm

rag --> sc

emb <|.. ge
emb <|.. le
llm <|.. glp
vs <|.. pvs
sp <|.. ss
dp <|.. mnp

factory ..> sc
factory ..> emb
factory ..> llm

note right of sc
Core orchestrator
Multi-provider support
end note

note right of factory
DI container
Creates all providers
end note

@enduml
