@startuml media_activity
title Media Processing Pipeline

start

:Detect media type;

switch (media_type?)
case (image)
    :Load with Pillow;
    :Resize to 1024px;
    :Send to Vision API;
    
case (audio)
    :Convert to OGG;
    :Send to Audio API;
    
case (video)
    :Extract frames;
    :Extract audio;
    :Send to APIs;
endswitch

:Parse response;
:Create MediaAnalysisResult;
:Generate embedding;
:Store in DB;

stop

note right of "Detect media type"
Supports:
- Images: jpg, png, webp
- Audio: mp3, wav, m4a
- Video: mp4, mov
end note

@enduml
